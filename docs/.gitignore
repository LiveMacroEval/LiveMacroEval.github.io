# docs/ is the published website. Nothing that carries row-level data may live
# here -- the repo is public and several pipeline inputs are not redistributable
# (see ../DATA_SOURCES.md). Belt and braces on top of check_release_safety.py.

*.csv
*.tsv
*.jsonl
*.parquet
*.xlsx
*.xls
*.pkl
*.pickle
*.feather
*.h5
*.hdf5
*.db
*.sqlite

# The paper PDF is deliberately not hosted here.
*.pdf

# Local preview / tooling noise
__pycache__/
.DS_Store

# Only the JSON the site actually publishes is allowed through; block strays.
# series.json carries the line-chart data and is capped and shape-checked by
# check_release_safety.check_series() -- see the note there for why a time
# series is publishable at all.
data/*.json
!data/leaderboard.json
!data/series.json
